# ============================================================
# ADWALLZ Wall Survey Automation
# Environment Configuration
# ============================================================

# OpenStreetMap / Nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Overpass API
OVERPASS_URL=https://overpass-api.de/api/interpreter

# IMPORTANT:
# Replace with a real contact identifier before production use.
OSM_USER_AGENT=ADWALLZ-Wall-Survey-Automation/1.0

# Google Street View
GOOGLE_STREETVIEW_API_KEY=
STREETVIEW_RADIUS_M=50
STREETVIEW_IMAGE_WIDTH=640
STREETVIEW_IMAGE_HEIGHT=640
STREETVIEW_FOV=90
STREETVIEW_PITCH=0
STREETVIEW_SOURCE=outdoor
STREETVIEW_RETRY_COUNT=3
STREETVIEW_TIMEOUT_SECONDS=30
# Mapillary
MAPILLARY_ACCESS_TOKEN=
MAPILLARY_RADIUS_M=50
MAPILLARY_LIMIT=1
MAPILLARY_TIMEOUT_SECONDS=30
MAPILLARY_RETRY_COUNT=3
